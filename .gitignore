
# Added by CADK
.cadk/

# broot runtime artifacts
.config/broot/launcher/

# Machine-local Git settings
.gitconfig
.gitconfig.local
.gitconfig.backup.*

# Hammerspoon: track configuration, not downloaded Spoons or runtime files
.hammerspoon/*
!.hammerspoon/init.lua

# OMP: track keybindings and shared capabilities, not credentials or runtime state
.omp/*
!.omp/agent/
.omp/agent/*
!.omp/agent/keybindings.yml
!.omp/agent/skills
!.omp/agent/extensions

# Antigravity: track keybindings and shared skills, not credentials or runtime state
.gemini/*
!.gemini/antigravity-cli/
.gemini/antigravity-cli/*
!.gemini/antigravity-cli/keybindings.json
!.gemini/config/
.gemini/config/*
!.gemini/config/skills

# Generated caches and local artifacts
.DS_Store
.cache/
.ruff_cache/
.pytest_cache/
.mypy_cache/
__pycache__/
*.py[cod]

# test scripts
.config/nvim/tests/
.config/tmux/tests/*

# zed
.config/zed/prompts/
