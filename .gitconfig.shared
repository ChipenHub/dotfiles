[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
	quotepath = false
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	side-by-side = true
	hunk-header-style = file line-number syntax
	width = variable
	wrap-right-percent = 0.01
	pager = ov
	paging = always
