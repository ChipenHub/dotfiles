#!/usr/bin/env python3

"""Select a space-delimited word or extend an active tmux selection."""

from __future__ import annotations

import subprocess
import sys


def main() -> int:
    if len(sys.argv) != 2:
        return 2

    pane_id = sys.argv[1]
    selection_present = subprocess.check_output(
        [
            "tmux",
            "display-message",
            "-p",
            "-t",
            pane_id,
            "#{selection_present}",
        ],
        text=True,
    ).strip()

    if selection_present != "1":
        separators = subprocess.check_output(
            ["tmux", "show-options", "-gv", "word-separators"],
            text=True,
        ).rstrip("\n")
        subprocess.run(
            ["tmux", "set-option", "-g", "word-separators", " "],
            check=True,
        )
        try:
            subprocess.run(
                ["tmux", "send-keys", "-t", pane_id, "-X", "select-word"],
                check=True,
            )
            subprocess.run(
                [
                    "tmux",
                    "send-keys",
                    "-t",
                    pane_id,
                    "-X",
                    "selection-mode",
                    "char",
                ],
                check=True,
            )
        finally:
            subprocess.run(
                ["tmux", "set-option", "-g", "word-separators", separators],
                check=True,
            )
        return 0

    subprocess.run(
        [
            "tmux",
            "send-keys",
            "-t",
            pane_id,
            "-X",
            "selection-mode",
            "char",
        ],
        check=True,
    )
    subprocess.run(
        ["tmux", "send-keys", "-t", pane_id, "-X", "next-space-end"],
        check=True,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
