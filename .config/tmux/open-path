#!/usr/bin/env python3

"""Open a copied path through nnn in a tmux pane or window."""

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path


IGNORED_DIRS = {".git", ".cache", "node_modules"}
NNN_PLUGIN_KEYS = tuple("OEZ9876543210ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz")


def tmux_message(message: str) -> None:
    subprocess.run(
        ["tmux", "display-message", f"open-path: {message}"],
        check=False,
    )


def set_pane_name(pane_id: str, name: str) -> None:
    subprocess.run(
        ["tmux", "set-option", "-p", "-t", pane_id, "@open_path_name", name],
        check=False,
    )


def pane_directory(pane_id: str) -> Path:
    output = subprocess.check_output(
        ["tmux", "display-message", "-p", "-t", pane_id, "#{pane_current_path}"],
        text=True,
    )
    return Path(output.strip()).resolve()


def split_location(raw: str) -> tuple[str, int | None, int | None]:
    token = re.sub(r"\s+", "", raw)

    wrappers = {"\"": "\"", "'": "'", "`": "`", "(": ")", "[": "]", "{": "}", "<": ">"}
    while len(token) >= 2 and wrappers.get(token[0]) == token[-1]:
        token = token[1:-1].strip()
    token = token.rstrip(",;:")

    match = re.fullmatch(r"(.+?):(\d+)(?::(\d+))?", token)
    if match:
        return (
            match.group(1),
            int(match.group(2)),
            int(match.group(3)) if match.group(3) else None,
        )

    match = re.fullmatch(r"(.+)\((\d+)(?:,(\d+))?\)", token)
    if match:
        return (
            match.group(1),
            int(match.group(2)),
            int(match.group(3)) if match.group(3) else None,
        )

    return token, None, None


def search_root(cwd: Path) -> Path:
    result = subprocess.run(
        ["git", "-C", str(cwd), "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode == 0 and result.stdout.strip():
        return Path(result.stdout.strip()).resolve()
    return cwd


def entries_named(name: str, root: Path) -> list[Path]:
    fd = shutil.which("fd") or shutil.which("fdfind")
    if fd:
        result = subprocess.run(
            [
                fd,
                "--type",
                "f",
                "--type",
                "d",
                "--hidden",
                "--exclude",
                ".git",
                "--exclude",
                ".cache",
                "--exclude",
                "node_modules",
                "--fixed-strings",
                name,
                str(root),
            ],
            capture_output=True,
            text=True,
            check=False,
        )
        paths = [Path(line).resolve() for line in result.stdout.splitlines()]
        return [path for path in paths if path.name == name]

    matches: list[Path] = []
    for directory, dirnames, filenames in os.walk(root):
        dirnames[:] = [item for item in dirnames if item not in IGNORED_DIRS]
        if name in dirnames:
            matches.append((Path(directory) / name).resolve())
        if name in filenames:
            matches.append((Path(directory) / name).resolve())
    return matches


def resolve_path(text: str, cwd: Path) -> tuple[Path | None, list[Path]]:
    expanded = Path(os.path.expandvars(os.path.expanduser(text)))
    direct = expanded if expanded.is_absolute() else cwd / expanded
    if direct.exists():
        return direct.resolve(), []

    name = expanded.name
    if not name:
        return None, []

    matches = entries_named(name, search_root(cwd))
    wanted = expanded.as_posix().lstrip("./")

    if "/" in wanted:
        suffix_matches = [
            path for path in matches if path.as_posix().endswith(f"/{wanted}")
        ]
        if suffix_matches:
            matches = suffix_matches

    cwd_matches = [path for path in matches if path.is_relative_to(cwd)]
    if cwd_matches:
        matches = cwd_matches

    if len(matches) == 1:
        return matches[0], []
    return None, matches


def editor_command(
    path: Path,
    line: int | None,
    column: int | None,
) -> list[str]:
    command = ["nvim"]
    if line is not None and column is not None:
        command.append(f"+call cursor({line},{column})")
    elif line is not None:
        command.append(f"+{line}")
    command.extend(["--", str(path)])
    return command


def nnn_editor_plugin(
    line: int | None,
    column: int | None,
    existing_plugins: str,
) -> tuple[str, str]:
    used_keys = {
        entry.split(":", 1)[0]
        for entry in existing_plugins.split(";")
        if ":" in entry
    }
    key = next(key for key in NNN_PLUGIN_KEYS if key not in used_keys)

    if line is not None and column is not None:
        editor = f'nvim "+call cursor({line},{column})" -- "$nnn"'
    elif line is not None:
        editor = f'nvim +{line} -- "$nnn"'
    else:
        editor = 'nvim -- "$nnn"'

    plugin = f"{key}:-!{editor}*"
    existing_plugins = existing_plugins.rstrip(";")
    plugins = f"{existing_plugins};{plugin}" if existing_plugins else plugin
    return key, plugins


def run_nnn(
    path: Path,
    line: int | None,
    column: int | None,
) -> None:
    environment = os.environ.copy()
    environment["EDITOR"] = "nvim"
    environment["VISUAL"] = "nvim"
    environment["NNN_OPENER"] = str(Path.home() / ".config/nnn/opener")
    command = ["nnn", "-ecA"]

    if path.is_file():
        key, plugins = nnn_editor_plugin(
            line,
            column,
            environment.get("NNN_PLUG", ""),
        )
        environment["NNN_PLUG"] = plugins
        command.extend(["-P", key])

    command.append(str(path))
    os.execvpe(command[0], command, environment)


def nnn_launcher_command(
    path: Path,
    line: int | None,
    column: int | None,
) -> list[str]:
    return [
        str(Path(__file__).resolve()),
        "--nnn-open",
        str(path),
        str(line or 0),
        str(column or 0),
    ]


def find_reusable_nvim(pane_id: str) -> tuple[str, str] | None:
    result = subprocess.run(
        [
            "tmux",
            "list-panes",
            "-t",
            pane_id,
            "-F",
            "#{pane_id}\t#{@nvim_server}",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return None

    panes = result.stdout.splitlines()
    if len(panes) > 3:
        return None

    candidates: list[tuple[str, str]] = []
    for entry in panes:
        candidate_pane, _, server = entry.partition("\t")
        if not server:
            continue
        probe = subprocess.run(
            ["nvim", "--server", server, "--remote-expr", "1"],
            capture_output=True,
            text=True,
            check=False,
        )
        if probe.returncode == 0:
            candidates.append((candidate_pane, server))

    return candidates[0] if len(candidates) == 1 else None


def open_in_nvim(
    pane_id: str,
    server: str,
    path: Path,
    line: int | None,
    column: int | None,
) -> bool:
    path_literal = json.dumps(str(path), ensure_ascii=False)
    expression = f"execute('hide edit ' . fnameescape({path_literal}))"
    result = subprocess.run(
        ["nvim", "--server", server, "--remote-expr", expression],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return False

    if line is not None:
        subprocess.run(
            [
                "nvim",
                "--server",
                server,
                "--remote-expr",
                f"cursor({line}, {column or 1})",
            ],
            capture_output=True,
            text=True,
            check=False,
        )

    set_pane_name(pane_id, path.name)
    subprocess.run(["tmux", "select-pane", "-t", pane_id], check=False)
    return True


def open_target(
    pane_id: str,
    path: Path,
    line: int | None,
    column: int | None,
    destination: str,
) -> None:
    if destination == "pane" and path.is_file():
        reusable_nvim = find_reusable_nvim(pane_id)
        if reusable_nvim is not None:
            nvim_pane, server = reusable_nvim
            if open_in_nvim(nvim_pane, server, path, line, column):
                return

    program: list[str] = []
    working_directory = path if path.is_dir() else path.parent
    if shutil.which("nnn"):
        program = nnn_launcher_command(path, line, column)
    elif path.is_file():
        program = editor_command(path, line, column)

    if destination == "window":
        tmux_args = [
            "tmux",
            "new-window",
            "-P",
            "-F",
            "#{pane_id}",
            "-n",
            path.name,
            "-c",
            str(working_directory),
        ]
    else:
        tmux_args = [
            "tmux",
            "split-window",
            "-P",
            "-F",
            "#{pane_id}",
            "-h",
            "-p",
            "60",
            "-t",
            pane_id,
            "-c",
            str(working_directory),
        ]

    result = subprocess.run(
        [*tmux_args, *program],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        tmux_message(result.stderr.strip() or "could not create the path pane")
    elif result.stdout.strip():
        set_pane_name(result.stdout.strip(), path.name)


def choose_target(
    pane_id: str,
    cwd: Path,
    matches: list[Path],
    line: int | None,
    column: int | None,
    destination: str,
) -> None:
    chooser = [
        str(Path(__file__).resolve()),
        "--choose",
        pane_id,
        destination,
        str(cwd),
        str(line or 0),
        str(column or 0),
        *[str(path) for path in matches],
    ]
    result = subprocess.run(
        [
            "tmux",
            "display-popup",
            "-E",
            "-t",
            pane_id,
            "-d",
            str(cwd),
            "-w",
            "80%",
            "-h",
            "80%",
            *chooser,
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        tmux_message(result.stderr.strip() or "could not open the path chooser")


def run_chooser() -> int:
    if len(sys.argv) < 8:
        tmux_message("path chooser received no candidates")
        return 2

    pane_id = sys.argv[2]
    destination = sys.argv[3]
    cwd = Path(sys.argv[4])
    line = int(sys.argv[5]) or None
    column = int(sys.argv[6]) or None
    matches = [Path(value) for value in sys.argv[7:]]

    result = subprocess.run(
        [
            "fzf",
            "--prompt=Open path > ",
            "--layout=reverse",
            "--no-multi",
        ],
        input="\n".join(str(path) for path in matches),
        stdout=subprocess.PIPE,
        text=True,
        check=False,
    )
    if result.returncode != 0 or not result.stdout.strip():
        return 0

    path = Path(result.stdout.strip())
    if not path.is_absolute():
        path = (cwd / path).resolve()
    open_target(pane_id, path, line, column, destination)
    return 0


def main() -> int:
    if len(sys.argv) == 5 and sys.argv[1] == "--nnn-open":
        path = Path(sys.argv[2])
        run_nnn(path, int(sys.argv[3]) or None, int(sys.argv[4]) or None)
        return 0

    if len(sys.argv) >= 2 and sys.argv[1] == "--choose":
        return run_chooser()

    if len(sys.argv) not in {2, 3}:
        tmux_message("missing source pane")
        return 2

    destination = sys.argv[2] if len(sys.argv) == 3 else "pane"
    if destination not in {"pane", "window"}:
        tmux_message(f"invalid destination {destination!r}")
        return 2

    raw = sys.stdin.read()
    path_text, line, column = split_location(raw)
    if not path_text:
        tmux_message("no path selected")
        return 1

    pane_id = sys.argv[1]
    cwd = pane_directory(pane_id)
    path, matches = resolve_path(path_text, cwd)
    if path is None:
        if matches:
            choose_target(pane_id, cwd, matches, line, column, destination)
            return 0
        else:
            tmux_message(f"cannot find {path_text!r} from {cwd}")
        return 1

    open_target(pane_id, path, line, column, destination)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
