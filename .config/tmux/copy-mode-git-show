#!/usr/bin/env python3

"""Show a copied commit hash in a temporary tmux window using Git's pager."""

import re
import subprocess
import sys


def main():
    pane = sys.argv[1]
    revision = sys.stdin.read().strip()
    if not re.fullmatch(r"[0-9a-fA-F]{4,64}", revision):
        subprocess.run(["tmux", "display-message", "copy-mode-git-show: select a commit hash"], check=True)
        return

    cwd = subprocess.check_output(
        ["tmux", "display-message", "-p", "-t", pane, "#{pane_current_path}"],
        text=True,
    ).strip()
    commit = subprocess.run(
        ["git", "-C", cwd, "rev-parse", "--verify", revision + "^{commit}"],
        capture_output=True, text=True,
    )
    if commit.returncode:
        subprocess.run(
            ["tmux", "display-message", "copy-mode-git-show: " + commit.stderr.strip()],
            check=True,
        )
        return

    session = subprocess.check_output(
        ["tmux", "display-message", "-p", "-t", pane, "#{session_id}"], text=True,
    ).strip()
    subprocess.run(
        ["tmux", "new-window", "-t", session + ":", "-c", cwd, "-n", "git-show-" + revision,
         "git", "--paginate", "show", commit.stdout.strip(), "--"],
        check=True,
    )


if __name__ == "__main__":
    main()
