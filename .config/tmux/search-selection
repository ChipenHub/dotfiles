#!/usr/bin/env python3

"""Search selected tmux copy-mode text with ripgrep in a popup."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


def pane_directory(pane_id: str) -> Path:
    output = subprocess.check_output(
        ["tmux", "display-message", "-p", "-t", pane_id, "#{pane_current_path}"],
        text=True,
    )
    return Path(output.strip()).resolve()


def search_root(cwd: Path) -> Path:
    result = subprocess.run(
        ["git", "-C", str(cwd), "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode == 0 and result.stdout.strip():
        return Path(result.stdout.strip()).resolve()
    return cwd


def normalize_query(raw: str) -> str:
    return raw.replace("\r", "").replace("\n", "").strip()


def show_results(query: str) -> int:
    result = subprocess.run(
        ["rg", "-n", "-F", "--color=always", "--", query, "."],
        check=False,
    )
    if result.returncode == 1:
        print(f"No matches for {query!r}")
    return result.returncode


def open_popup(pane_id: str, root: Path, query: str) -> int:
    result = subprocess.run(
        [
            "tmux",
            "display-popup",
            "-k",
            "-t",
            pane_id,
            "-T",
            " ripgrep ",
            "-d",
            str(root),
            "-w",
            "90%",
            "-h",
            "80%",
            str(Path(__file__).resolve()),
            "--show",
            query,
        ],
        check=False,
    )
    return result.returncode


def main() -> int:
    if len(sys.argv) == 3 and sys.argv[1] == "--show":
        return show_results(sys.argv[2])

    if len(sys.argv) != 2:
        return 2

    query = normalize_query(sys.stdin.read())
    if not query:
        subprocess.run(["tmux", "display-message", "search-selection: no text selected"])
        return 1

    pane_id = sys.argv[1]
    return open_popup(pane_id, search_root(pane_directory(pane_id)), query)


if __name__ == "__main__":
    raise SystemExit(main())
