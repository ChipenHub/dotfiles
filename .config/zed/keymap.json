// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace || Editor || Terminal",
    "bindings": {
      "alt-h": "workspace::ActivatePaneLeft",
      "alt-j": "workspace::ActivatePaneDown",
      "alt-k": "workspace::ActivatePaneUp",
      "alt-l": "workspace::ActivatePaneRight",
      "alt-v": "pane::SplitRight",
      "alt-s": "pane::SplitDown"
    },
  },
  {
    // Match Neovim's Emacs-style insert-mode bindings.
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-f": "editor::MoveRight",
      "ctrl-b": "editor::MoveLeft",
      "ctrl-p": ["workspace::SendKeystrokes", "up"],
      "ctrl-n": ["workspace::SendKeystrokes", "down"],
      "alt-f": "editor::MoveToNextWordEnd",
      "alt-b": "editor::MoveToPreviousWordStart",
      "ctrl-a": ["editor::MoveToBeginningOfLine", { "stop_at_soft_wraps": false, "stop_at_indent": false }],
      "ctrl-e": ["editor::MoveToEndOfLine", { "stop_at_soft_wraps": false }],
      "ctrl-k": "editor::DeleteToEndOfLine",
      "ctrl-j": "editor::Newline",
      "ctrl-h": "editor::Backspace",
      "ctrl-d": "editor::Delete",
      "ctrl-space": ["workspace::SendKeystrokes", "escape v"]
    },
  },
  {
    "unbind": {
      "ctrl-escape": "menu::Cancel"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-escape": "terminal_panel::Toggle"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-`": "terminal_panel::Toggle"
    }
  },
  {
    "context": "!Editor && !Terminal",
    "bindings": {
      "q": "pane::CloseActiveItem"
    }
  },
  {
    // Cancel search/overlays without intercepting q in text inputs or terminals.
    "context": "Editor && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "q": ["workspace::SendKeystrokes", "escape"]
    }
  },
  {
    "context": "ProjectSearchView > Editor && vim_mode == normal",
    "bindings": {
      "q": "pane::CloseActiveItem"
    }
  },
  {
    "context": "(ProjectPanel && not_editing) || (OutlinePanel && not_editing) || (GitPanel && !Editor)",
    "bindings": {
      "q": "workspace::CloseActiveDock"
    }
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "q": "pane::CloseActiveItem"
    }
  }
]
